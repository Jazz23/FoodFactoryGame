{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "coordinator",
  "subagent_depth": 1,
  "watcher": {
    "ignore": [
      ".opencode/node_modules/**",
      "Library/**",
      "Temp/**",
      "Logs/**",
      "TestResults/**",
      "Obj/**",
      "Build/**",
      "Builds/**",
      "UserSettings/**",
      "MemoryCaptures/**",
      "Recordings/**",
      "factory-world.db*"
    ]
  },
  "tool_output": {
    "max_lines": 120,
    "max_bytes": 8192
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 12000
  }
}
