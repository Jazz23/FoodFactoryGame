/* The game's shared UI look (decisions 0040, 0042): one dark palette with a single amber accent, rounded panels and flat
   slots. Imported for every panel by DevRuntimeTheme.tss; each screen's UXML also references it so UI Builder previews it.
   Colours are tokens on :root; components are ff-* classes. Screens add their own sheet beside their UXML. */

:root {
    --ff-panel: #1B1C1F;
    --ff-overlay: rgba(22, 23, 26, 0.86);
    --ff-backdrop: #16171A;
    --ff-edge: #34373C;
    --ff-edge-strong: #4A4D53;
    --ff-inset: #141517;
    --ff-card: #232528;
    --ff-card-edge: #2E3135;
    --ff-control: #2A2C30;
    --ff-control-hover: #34373C;
    --ff-control-edge: #3C3F44;
    --ff-slot: #26282C;
    --ff-slot-empty: #222327;
    --ff-dim: rgba(10, 10, 12, 0.55);
    --ff-text: #ECE8E1;
    --ff-text-soft: #CFCBC3;
    --ff-muted: #A8A49B;
    --ff-faint: #8F8B83;
    --ff-disabled: #6A675F;
    --ff-ink: #16171A;
    --ff-accent: #F2A33A;
    --ff-accent-hover: #FFB95A;
    --ff-accent-ink: #3B2A12;
    --ff-notice: #FFC170;
    --ff-positive: #6FCB86;
    --ff-power-on: #3E9A57;
    --ff-danger: #E5644E;
    --ff-danger-text: #FF8A78;
    --ff-danger-edge: #5A3A36;
    --ff-warning: #FF9A6B;
    --ff-chilled: #7CC8F0;
    --ff-spoiled-fill: #3A2523;
    --ff-knob: #F4F1EA;
    --ff-code: #111214;
    --ff-code-text: #CFE3C8;
}

/* ---------- Text ---------- */

/* Every screen root carries ff-root: text colour inherits from it. Labels lose the default theme's margins and padding; this
   rule has the default theme's specificity and comes after it, and every later class (here and in screen sheets) wins over it. */
.ff-root {
    color: var(--ff-text);
}

.unity-label {
    margin: 0;
    padding: 0;
}

.ff-text { font-size: 14px; color: var(--ff-text); }
.ff-small { font-size: 12px; color: var(--ff-muted); }
.ff-tiny { font-size: 11px; color: var(--ff-faint); }
.ff-strong { -unity-font-style: bold; }
.ff-wrap { white-space: normal; }
.ff-nowrap { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ff-center-text { -unity-text-align: middle-center; }

/* Small upper-case caption over a value ("CASH", "IN"). */
.ff-eyebrow {
    font-size: 11px;
    color: var(--ff-muted);
    letter-spacing: 1px;
}

/* A window's bold title, and the muted line beside or under it. */
.ff-title { font-size: 17px; -unity-font-style: bold; color: var(--ff-text); }
.ff-page-title { font-size: 32px; -unity-font-style: bold; color: var(--ff-text); }

.ff-muted { color: var(--ff-muted); }
.ff-soft { color: var(--ff-text-soft); }
.ff-faint { color: var(--ff-faint); }
.ff-accent-text { color: var(--ff-accent); }
.ff-danger-text { color: var(--ff-danger-text); }
.ff-warning-text { color: var(--ff-warning); }
.ff-notice-text { color: var(--ff-notice); }
.ff-chilled-text { color: var(--ff-chilled); }
.ff-positive-text { color: var(--ff-positive); }
.ff-ink-text { color: var(--ff-ink); }

/* ---------- Layout ---------- */

.ff-fill {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.ff-row { flex-direction: row; align-items: center; }
.ff-column { flex-direction: column; }
.ff-spacer { flex-grow: 1; }
.ff-grow { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.ff-no-shrink { flex-shrink: 0; }
.ff-hidden { display: none; }

.ff-divider {
    height: 1px;
    background-color: var(--ff-edge);
    margin-top: 4px;
    margin-bottom: 4px;
    flex-shrink: 0;
}

/* Darkens the world behind an open screen; never takes a click (picking-mode="Ignore" in UXML). */
.ff-dim { background-color: var(--ff-dim); }

/* A screen centred on the panel. */
.ff-centered {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
}

/* ---------- Surfaces ---------- */

/* A screen window: solid panel, hairline edge, 14 px corners. */
.ff-panel {
    background-color: var(--ff-panel);
    border-width: 1px;
    border-color: var(--ff-edge);
    border-radius: 14px;
    padding: 16px;
}

/* A card floating over the world (HUD cards, menu cards). */
.ff-overlay-card {
    background-color: var(--ff-overlay);
    border-width: 1px;
    border-color: var(--ff-edge);
    border-radius: 12px;
    padding: 10px 14px;
}

/* A list row on a card (offers, employees, routes). */
.ff-card {
    background-color: var(--ff-card);
    border-width: 1px;
    border-color: var(--ff-card-edge);
    border-radius: 10px;
    padding: 10px 12px;
    margin-top: 6px;
}

/* The darker well inside a window. */
.ff-inset {
    background-color: var(--ff-inset);
    border-radius: 12px;
    padding: 16px;
}

/* A small stat tile: caption over a value. */
.ff-tile {
    flex-grow: 1;
    flex-basis: 0;
    background-color: var(--ff-inset);
    border-radius: 10px;
    padding: 10px;
}

.ff-tile__value { font-size: 15px; -unity-font-style: bold; margin-top: 4px; }

/* ---------- Buttons ---------- */

.ff-button {
    height: 36px;
    margin: 0;
    padding: 0 12px;
    background-color: var(--ff-control);
    border-width: 1px;
    border-color: var(--ff-control-edge);
    border-radius: 8px;
    color: var(--ff-text);
    font-size: 13px;
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.ff-button:hover { background-color: var(--ff-control-hover); }
.ff-button:active { background-color: var(--ff-edge-strong); }
.ff-button:disabled { opacity: 0.45; }

/* Filled amber: the one main action of a screen (Run, Hire, Play). */
.ff-button--primary {
    background-color: var(--ff-accent);
    border-width: 0;
    color: var(--ff-ink);
    -unity-font-style: bold;
    font-size: 14px;
    padding: 0 20px;
}

.ff-button--primary:hover { background-color: var(--ff-accent-hover); }
.ff-button--primary:active { background-color: var(--ff-accent); }

/* Outlined red: removing something (Fire, Delete). */
.ff-button--danger {
    background-color: rgba(0, 0, 0, 0);
    border-color: var(--ff-danger-edge);
    color: var(--ff-danger-text);
}

.ff-button--danger:hover { background-color: rgba(90, 58, 54, 0.35); }

/* No fill until hovered (tabs, dashed adds, chip removes). */
.ff-button--ghost { background-color: rgba(0, 0, 0, 0); }

/* See-through dark fill for buttons over the world or the menu backdrop. */
.ff-button--overlay { background-color: var(--ff-overlay); border-color: var(--ff-edge); }

.ff-button--sm { height: 32px; font-size: 12px; }
.ff-button--lg { height: 44px; border-radius: 10px; font-size: 14px; }
.ff-button--xl { height: 56px; border-radius: 12px; font-size: 17px; }

/* A square icon-only button (close, remove). */
.ff-button--icon {
    width: 32px;
    height: 32px;
    padding: 0;
    color: var(--ff-muted);
    align-items: center;
    justify-content: center;
}

.ff-button--icon:hover { color: var(--ff-text); }

/* A tool or style choice that stays lit while chosen. */
.ff-chip {
    height: 32px;
    margin: 3px;
    padding: 0 12px;
    font-size: 13px;
}

.ff-chip--chosen {
    background-color: var(--ff-accent);
    border-color: var(--ff-accent);
    color: var(--ff-ink);
    -unity-font-style: bold;
}

.ff-chip--chosen:hover { background-color: var(--ff-accent-hover); }

/* A segmented control: one option button per choice, the chosen one lit. */
.ff-segmented {
    flex-direction: row;
    align-items: center;
    background-color: var(--ff-inset);
    border-radius: 10px;
    padding: 3px;
}

.ff-segment {
    height: 34px;
    min-width: 44px;
    margin: 0;
    padding: 0 12px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 8px;
    color: var(--ff-muted);
    font-size: 13px;
}

.ff-segment:hover { background-color: var(--ff-control); }
.ff-segment--chosen { background-color: var(--ff-edge); color: var(--ff-text); }
.ff-segment:disabled { opacity: 0.4; }

/* ---------- Slots and icons ---------- */

.ff-slot {
    width: 44px;
    height: 44px;
    margin: 2px;
    padding: 0;
    background-color: var(--ff-slot-empty);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 8px;
    align-items: center;
    justify-content: center;
}

.ff-slot--filled { background-color: var(--ff-slot); }
.ff-slot--spoiled { background-color: var(--ff-spoiled-fill); }
.ff-slot--selected { border-width: 2px; border-color: var(--ff-accent); }

.ff-slot__count {
    position: absolute;
    right: 5px;
    bottom: 2px;
    font-size: 12px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 0 rgb(0, 0, 0);
}

.ff-slot__timer {
    position: absolute;
    left: 4px;
    top: 2px;
    font-size: 9px;
    -unity-font-style: bold;
    text-shadow: 1px 1px 0 rgb(0, 0, 0);
}

.ff-icon {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
    justify-content: center;
}

.ff-icon--faded { opacity: 0.3; }
.ff-icon--dim { opacity: 0.35; }
.ff-icon--spoiled { -unity-background-image-tint-color: rgb(153, 191, 89); }

/* An icon with no content stands its name in. */
.ff-icon__name { font-size: 10px; white-space: normal; -unity-text-align: middle-center; }

/* An empty icon box (a place with no machine). */
.ff-icon--empty { background-color: var(--ff-slot-empty); border-radius: 8px; }

/* ---------- Status ---------- */

.ff-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    flex-shrink: 0;
    background-color: var(--ff-faint);
}

.ff-dot--sm { width: 7px; height: 7px; border-radius: 4px; }
.ff-dot--danger { background-color: var(--ff-danger); }
.ff-dot--positive { background-color: var(--ff-positive); }
.ff-dot--accent { background-color: var(--ff-accent); }

.ff-avatar {
    width: 36px;
    height: 36px;
    border-radius: 18px;
    flex-shrink: 0;
    background-color: var(--ff-edge);
    align-items: center;
    justify-content: center;
}

.ff-avatar--lg { width: 44px; height: 44px; border-radius: 22px; }
.ff-avatar__initial { font-size: 16px; -unity-font-style: bold; }
.ff-avatar--lg .ff-avatar__initial { font-size: 20px; }

/* A thin rounded progress track; the code sizes the fill's width in percent. */
.ff-progress {
    height: 6px;
    background-color: var(--ff-control);
    border-radius: 3px;
    overflow: hidden;
}

.ff-progress__fill {
    height: 100%;
    width: 0;
    background-color: var(--ff-accent);
    border-radius: 3px;
}

/* ---------- Fields ---------- */

/* A dark text box with a light caret and a blue selection (custom properties inline styles cannot set). */
.ff-text-field {
    margin: 0;
    --unity-cursor-color: #ECE8E1;
    --unity-selection-color: rgba(89, 140, 255, 0.45);
}

.ff-text-field > .unity-base-text-field__input {
    background-color: var(--ff-control);
    color: var(--ff-text);
    border-width: 1px;
    border-color: var(--ff-control-edge);
    border-radius: 8px;
    font-size: 15px;
    min-height: 40px;
    padding-left: 10px;
}

.ff-text-field:focus > .unity-base-text-field__input { border-color: var(--ff-accent); }

.ff-text-field--compact > .unity-base-text-field__input { font-size: 13px; min-height: 32px; background-color: var(--ff-panel); }

/* A labelled field: caption over the control. */
.ff-field { margin-bottom: 16px; }
.ff-field__caption { margin-bottom: 6px; }

.ff-toggle {
    margin: 4px 0 0 0;
    flex-grow: 0;
    align-self: flex-start;
    font-size: 14px;
}

.ff-root .ff-toggle .unity-base-field__label,
.ff-root .ff-toggle .unity-toggle__text {
    min-width: auto;
    margin-right: 8px;
    color: var(--ff-text);
    font-size: 14px;
}

.ff-toggle .unity-toggle__checkmark {
    background-color: var(--ff-panel);
    border-width: 1px;
    border-color: var(--ff-control-edge);
    border-radius: 4px;
    -unity-background-image-tint-color: var(--ff-accent);
}

.ff-toggle:disabled { opacity: 0.45; }

.ff-dropdown { margin: 0; }

.ff-dropdown .unity-base-popup-field__input {
    height: 36px;
    background-color: var(--ff-panel);
    color: var(--ff-text);
    font-size: 14px;
    padding-left: 10px;
    border-width: 1px;
    border-color: var(--ff-control-edge);
    border-radius: 8px;
}

.ff-root .ff-dropdown .unity-base-popup-field__text { color: var(--ff-text); }

.ff-slider { margin: 0; }

.ff-slider .unity-base-slider__tracker {
    background-color: var(--ff-control);
    border-width: 1px;
    border-color: var(--ff-control-edge);
    border-radius: 3px;
}

.ff-slider .unity-base-slider__dragger {
    background-color: var(--ff-accent);
    border-width: 0;
    border-radius: 8px;
}

/* ---------- Scroll bars: thin and dark, no arrow buttons (selectors outrank the default theme's) ---------- */

.ff-scroll .unity-scroll-view__vertical-scroller,
.ff-scroll .unity-scroller--vertical {
    width: 8px;
    min-width: 8px;
    margin-left: 6px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}

.ff-scroll .unity-scroll-view__horizontal-scroller { display: none; }
.ff-scroll .unity-scroller--vertical .unity-scroller__low-button,
.ff-scroll .unity-scroller--vertical .unity-scroller__high-button { display: none; }
.ff-scroll .unity-scroller--vertical .unity-base-slider { margin-top: 0; margin-bottom: 0; }

.ff-scroll .unity-scroller--vertical .unity-base-slider__tracker {
    background-color: var(--ff-inset);
    border-width: 0;
    border-radius: 4px;
    width: 8px;
    left: 0;
}

.ff-scroll .unity-scroller--vertical .unity-base-slider__dragger {
    background-color: var(--ff-control-edge);
    border-width: 0;
    border-radius: 4px;
    width: 8px;
    left: 0;
}

/* ---------- Keycaps (prompts and key hints) ---------- */

.ff-keycap {
    min-width: 28px;
    height: 28px;
    padding: 0 6px;
    background-color: var(--ff-text);
    border-radius: 6px;
    -unity-text-align: middle-center;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--ff-ink);
}


/* ---------- Glyphs (drawn by Glyphs.cs in the element's text colour) ---------- */

.ff-glyph {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
}

.ff-glyph--sm { width: 12px; height: 12px; }
.ff-glyph--lg { width: 20px; height: 20px; }

/* A button holding a glyph and a label side by side. */
.ff-button--with-glyph { flex-direction: row; align-items: center; justify-content: center; }
.ff-button--with-glyph > .ff-glyph { margin-right: 8px; }
