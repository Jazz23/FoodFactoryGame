<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- A machine with recipes (decision 0008): input grid, progress arrow, output grid (or a sale station's prices), the
         progress line, and under them the register's staff row (decision 0034) and the power switch (decision 0037). -->
    <Style src="project://database/Assets/UI/Theme/Theme.uss" />
    <Style src="Hud.uss" />
    <ui:VisualElement name="hud-machine" class="ff-panel hud-window hud-machine">
        <ui:VisualElement class="ff-row hud-window__header" picking-mode="Ignore">
            <ui:Label name="title" class="ff-title" picking-mode="Ignore" />
            <ui:Label name="subtitle" class="hud-window__subtitle" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement class="ff-inset ff-row hud-machine__body">
            <ui:VisualElement class="hud-labelled">
                <ui:Label name="input-caption" class="ff-eyebrow hud-labelled__caption" picking-mode="Ignore" />
                <ui:VisualElement name="input-grid" />
            </ui:VisualElement>
            <ui:VisualElement class="hud-machine__middle" picking-mode="Ignore">
                <ui:VisualElement class="ff-glyph ff-glyph--arrow-right hud-machine__arrow" />
                <ui:VisualElement name="hud-progress" class="ff-progress" picking-mode="Ignore">
                    <ui:VisualElement name="hud-progress-fill" class="ff-progress__fill" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="output-column" class="hud-labelled">
                <ui:Label name="output-caption" class="ff-eyebrow hud-labelled__caption" picking-mode="Ignore" />
                <ui:VisualElement name="output-grid" />
            </ui:VisualElement>
            <ui:VisualElement name="hud-sale-prices" class="hud-machine__prices">
                <ui:Label text="SELLS" class="ff-eyebrow" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Label name="hud-progress-label" class="hud-machine__progress-label ff-wrap" picking-mode="Ignore" />
        <ui:VisualElement name="hud-staff" class="ff-row hud-register">
            <ui:Label name="hud-staff-label" class="hud-register__label ff-grow" picking-mode="Ignore" />
            <ui:Button name="hud-staff-button" focusable="false" class="ff-button hud-register__button" />
        </ui:VisualElement>
        <ui:VisualElement name="hud-power" class="ff-row hud-power">
            <ui:VisualElement class="ff-grow" picking-mode="Ignore">
                <ui:Label text="Power" class="ff-strong" picking-mode="Ignore" />
                <ui:Label name="hud-power-label" text="Switching..." class="ff-small hud-power__label" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="hud-power-switch" class="hud-power__switch">
                <ui:VisualElement class="hud-power__knob" picking-mode="Ignore">
                    <ui:Label name="hud-power-state" class="hud-power__state" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
