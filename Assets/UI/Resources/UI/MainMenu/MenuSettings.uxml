<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- Settings: name, mouse sensitivity, sound volumes, anti-aliasing, and the keybinds (MenuKeybindGroup/Row templates fill the two columns). -->
    <Style src="project://database/Assets/UI/Theme/Theme.uss" />
    <Style src="MainMenu.uss" />
    <ui:VisualElement name="main-menu-page" class="menu-page">
        <ui:VisualElement class="ff-row menu-page__header">
            <ui:Button name="menu-back" focusable="false" class="ff-button ff-button--lg ff-button--overlay ff-button--with-glyph menu-back">
                <ui:VisualElement class="ff-glyph ff-glyph--chevron-left" />
                <ui:Label text="Back" picking-mode="Ignore" />
            </ui:Button>
            <ui:Label text="Settings" class="ff-page-title menu-page__title" picking-mode="Ignore" />
            <ui:Button name="menu-reset-settings" text="Reset to defaults" focusable="false" class="ff-button ff-button--lg ff-button--overlay menu-settings__reset" />
            <ui:Button name="menu-settings-done" text="Done" focusable="false" class="ff-button ff-button--primary ff-button--lg" />
        </ui:VisualElement>
        <ui:VisualElement class="ff-row menu-page__body">
            <ui:ScrollView mode="Vertical" horizontal-scroller-visibility="Hidden" class="ff-scroll menu-settings__side">
                <ui:VisualElement class="menu-card menu-settings__card">
                    <ui:Label text="YOUR NAME" class="ff-eyebrow ff-field__caption" picking-mode="Ignore" />
                    <ui:TextField name="menu-settings-name" class="ff-text-field" />
                </ui:VisualElement>
                <ui:VisualElement class="menu-card menu-settings__card">
                    <ui:Label text="MOUSE" class="ff-eyebrow" picking-mode="Ignore" />
                    <ui:VisualElement class="ff-row menu-sensitivity__head" picking-mode="Ignore">
                        <ui:Label text="Sensitivity" class="ff-grow menu-sensitivity__caption" picking-mode="Ignore" />
                        <ui:Label name="menu-sensitivity-value" class="menu-sensitivity__value" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Slider name="menu-sensitivity" low-value="0.1" high-value="3" value="1" focusable="false" class="ff-slider menu-sensitivity__slider" />
                    <ui:VisualElement class="ff-row menu-sensitivity__scale" picking-mode="Ignore">
                        <ui:Label name="menu-sensitivity-min" class="ff-tiny ff-grow" picking-mode="Ignore" />
                        <ui:Label name="menu-sensitivity-max" class="ff-tiny" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="menu-card menu-settings__card">
                    <ui:Label text="SOUND" class="ff-eyebrow" picking-mode="Ignore" />
                    <ui:VisualElement class="ff-row menu-volume__row">
                        <ui:Label text="Master" class="menu-sensitivity__caption menu-volume__caption" picking-mode="Ignore" />
                        <ui:Slider name="menu-volume-master" low-value="0" high-value="1" value="1" focusable="false" class="ff-slider ff-grow menu-volume__slider" />
                        <ui:Label name="menu-volume-master-value" class="menu-sensitivity__value menu-volume__value" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="ff-row menu-volume__row">
                        <ui:Label text="Effects" class="menu-sensitivity__caption menu-volume__caption" picking-mode="Ignore" />
                        <ui:Slider name="menu-volume-effects" low-value="0" high-value="1" value="1" focusable="false" class="ff-slider ff-grow menu-volume__slider" />
                        <ui:Label name="menu-volume-effects-value" class="menu-sensitivity__value menu-volume__value" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="ff-row menu-volume__row">
                        <ui:Label text="Interface" class="menu-sensitivity__caption menu-volume__caption" picking-mode="Ignore" />
                        <ui:Slider name="menu-volume-interface" low-value="0" high-value="1" value="1" focusable="false" class="ff-slider ff-grow menu-volume__slider" />
                        <ui:Label name="menu-volume-interface-value" class="menu-sensitivity__value menu-volume__value" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="ff-row menu-volume__row">
                        <ui:Label text="Ambience" class="menu-sensitivity__caption menu-volume__caption" picking-mode="Ignore" />
                        <ui:Slider name="menu-volume-ambience" low-value="0" high-value="1" value="1" focusable="false" class="ff-slider ff-grow menu-volume__slider" />
                        <ui:Label name="menu-volume-ambience-value" class="menu-sensitivity__value menu-volume__value" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="menu-card menu-settings__card">
                    <ui:Label text="GRAPHICS" class="ff-eyebrow" picking-mode="Ignore" />
                    <ui:Label text="Anti-aliasing" class="menu-sensitivity__caption menu-aa__caption" picking-mode="Ignore" />
                    <ui:VisualElement name="menu-aa" class="ff-segmented menu-aa__options">
                        <ui:Button name="menu-aa-off" text="Off" focusable="false" class="ff-segment" />
                        <ui:Button name="menu-aa-fxaa" text="FXAA" focusable="false" class="ff-segment" />
                        <ui:Button name="menu-aa-smaa" text="SMAA" focusable="false" class="ff-segment" />
                        <ui:Button name="menu-aa-msaa2x" text="MSAA 2×" focusable="false" class="ff-segment" />
                        <ui:Button name="menu-aa-msaa4x" text="MSAA 4×" focusable="false" class="ff-segment" />
                        <ui:Button name="menu-aa-msaa8x" text="MSAA 8×" focusable="false" class="ff-segment" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="menu-card menu-card--quiet menu-settings__card">
                    <ui:Label text="REBINDING" class="ff-eyebrow" picking-mode="Ignore" />
                    <ui:Label text="Click a key, then press the new key or mouse button. Esc cancels; Backspace unbinds." class="ff-soft ff-wrap menu-settings__tip" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:ScrollView>
            <ui:VisualElement class="menu-card menu-keys">
                <ui:VisualElement class="ff-row menu-keys__header" picking-mode="Ignore">
                    <ui:Label text="KEYBINDS" class="ff-eyebrow ff-grow" picking-mode="Ignore" />
                    <ui:Label name="menu-binding-notice" class="ff-notice-text menu-keys__notice" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:ScrollView name="menu-keybinds" mode="Vertical" horizontal-scroller-visibility="Hidden" class="ff-scroll menu-keys__scroll">
                    <ui:VisualElement name="menu-keybind-columns" class="ff-row menu-keys__columns">
                        <ui:VisualElement name="menu-keybind-column-0" class="menu-keys__column" />
                        <ui:VisualElement name="menu-keybind-column-1" class="menu-keys__column menu-keys__column--second" />
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
