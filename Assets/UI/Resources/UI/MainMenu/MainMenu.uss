/* Main menu (decision 0041), from the "Main Menu" canvas: Main, Select World, Connect to server and Settings. Shared
   pieces (buttons, fields, scroll bars) come from Theme.uss. */

/* ---------- Frame ---------- */

/* Opaque: no camera renders at the menu, so a see-through backdrop would show stale frames. */
.menu {
    background-color: var(--ff-backdrop);
    align-items: center;
    justify-content: center;
}

.menu__content {
    flex-grow: 1;
    width: 100%;
    align-items: center;
    justify-content: center;
}

.menu__status {
    position: absolute;
    bottom: 28px;
    left: 0;
    right: 0;
    font-size: 13px;
    color: var(--ff-warning);
    -unity-text-align: middle-center;
}

/* ---------- Main screen ---------- */

.menu-main { width: 440px; }

.menu-main__brand { align-items: center; margin-bottom: 44px; }
.menu-main__brand-row { margin-bottom: 12px; }

.menu-main__logo {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background-color: var(--ff-control);
    border-width: 1px;
    border-color: var(--ff-edge);
    align-items: center;
    justify-content: center;
    margin-right: 12px;
}

.menu-main__logo-glyph { width: 22px; height: 22px; color: var(--ff-accent); }

.menu-main__eyebrow { font-size: 12px; color: var(--ff-muted); letter-spacing: 2px; }

.menu-main__title {
    font-size: 64px;
    -unity-font-style: bold;
    color: var(--ff-text);
    -unity-text-align: middle-center;
}

.menu-main__divider { margin-top: 6px; margin-bottom: 16px; }

/* Resume: filled amber, a dark play circle, the last session under its name. */
.menu-resume {
    flex-direction: row;
    align-items: center;
    margin: 0 0 10px 0;
    padding: 18px 20px;
    background-color: var(--ff-accent);
    border-width: 0;
    border-radius: 14px;
    color: var(--ff-ink);
    -unity-text-align: middle-left;
}

.menu-resume:hover { background-color: var(--ff-accent-hover); }
.menu-resume:disabled {
    background-color: var(--ff-control);
    border-width: 1px;
    border-color: var(--ff-control-edge);
    color: var(--ff-muted);
    opacity: 1;
}

.menu-resume__circle {
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background-color: var(--ff-ink);
    align-items: center;
    justify-content: center;
    margin-right: 16px;
    flex-shrink: 0;
}

.menu-resume:disabled .menu-resume__circle { background-color: var(--ff-inset); }

.menu-resume__play { width: 18px; height: 18px; margin-left: 3px; color: var(--ff-accent); }
.menu-resume:disabled .menu-resume__play { color: var(--ff-faint); }

.menu-resume__text { flex-grow: 1; flex-shrink: 1; }
.menu-resume__title { font-size: 22px; -unity-font-style: bold; }
.menu-resume__detail { font-size: 13px; margin-top: 3px; color: var(--ff-accent-ink); }
.menu-resume__ago { font-size: 12px; align-self: flex-start; margin: 4px 0 0 12px; color: var(--ff-accent-ink); }
.menu-resume:disabled .menu-resume__detail,
.menu-resume:disabled .menu-resume__ago { color: var(--ff-faint); }

/* A menu entry: label, then a chevron when it opens another screen. */
.menu-button {
    flex-direction: row;
    align-items: center;
    height: 60px;
    margin: 0 0 10px 0;
    padding: 0 18px;
    background-color: var(--ff-overlay);
    border-width: 1px;
    border-color: var(--ff-edge);
    border-radius: 12px;
    color: var(--ff-text);
    -unity-text-align: middle-left;
}

.menu-button:hover { background-color: var(--ff-control); border-color: var(--ff-edge-strong); }

.menu-button__label { flex-grow: 1; font-size: 17px; }
.menu-button__icon { width: 20px; height: 20px; margin-right: 14px; color: var(--ff-muted); }
.menu-button__chevron { width: 18px; height: 18px; color: var(--ff-faint); }

.menu-button--quiet { height: 52px; background-color: rgba(22, 23, 26, 0.6); color: var(--ff-text-soft); }
.menu-button--quiet .menu-button__label { font-size: 16px; }

/* ---------- Sub-screens ---------- */

.menu-page {
    flex-grow: 1;
    width: 100%;
    max-width: 1408px;
    padding: 48px;
}

.menu-page__header { margin-bottom: 28px; }
.menu-page__title { margin-left: 20px; flex-grow: 1; }
.menu-page__body { flex-grow: 1; align-items: stretch; }

.menu-back { padding-left: 12px; padding-right: 16px; }

.menu-card {
    background-color: var(--ff-overlay);
    border-width: 1px;
    border-color: var(--ff-edge);
    border-radius: 14px;
}

.menu-card--quiet { background-color: rgba(22, 23, 26, 0.6); }

/* Select World: the list. */
.menu-worlds { flex-grow: 1; flex-shrink: 1; margin-right: 24px; }

.menu-worlds__columns {
    padding: 14px 20px;
    border-bottom-width: 1px;
    border-color: var(--ff-edge);
}

.menu-worlds__list { flex-grow: 1; }
.menu-worlds__list > .unity-scroll-view__content-viewport > .unity-scroll-view__content-container { padding: 8px; }

.menu-world-row {
    flex-direction: row;
    align-items: center;
    margin: 0 0 4px 0;
    padding: 14px 12px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 10px;
    -unity-text-align: middle-left;
}

.menu-world-row:hover { background-color: var(--ff-control); }
.menu-world-row--selected { background-color: var(--ff-control); border-color: var(--ff-accent); }

.menu-world-row__tile {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background-color: var(--ff-control);
    align-items: center;
    justify-content: center;
    margin-right: 14px;
    flex-shrink: 0;
}

.menu-world-row--selected .menu-world-row__tile { background-color: var(--ff-edge); }
.menu-world-row__initial { font-size: 18px; -unity-font-style: bold; color: var(--ff-text-soft); }
.menu-world-row__name { font-size: 16px; }
.menu-world-row__played { font-size: 13px; color: var(--ff-muted); }

.menu-worlds__empty { padding: 12px; font-size: 14px; color: var(--ff-muted); }

/* Select World: the chosen world. */
.menu-details { width: 460px; flex-shrink: 0; padding: 24px; }
.menu-details__name { font-size: 24px; -unity-font-style: bold; }
.menu-details__sub { margin-top: 6px; margin-bottom: 20px; }
.menu-details__divider { margin-bottom: 20px; }

.menu-visibility { flex-shrink: 0; }
.menu-visibility__caption { margin-bottom: 8px; }

/* The dropdown's face and its options. */
.menu-choice {
    flex-direction: row;
    align-items: center;
    min-height: 52px;
    margin: 0;
    padding: 8px 12px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 8px;
    -unity-text-align: middle-left;
}

.menu-choice:hover { background-color: var(--ff-control); }

.menu-choice--current {
    background-color: var(--ff-control);
    border-width: 1px;
    border-color: var(--ff-edge);
    border-radius: 10px;
    min-height: 60px;
}

.menu-visibility--open .menu-choice--current { border-color: var(--ff-accent); }

.menu-choice__text { flex-grow: 1; flex-shrink: 1; }
.menu-choice__title { font-size: 15px; }
.menu-choice__description { font-size: 12px; color: var(--ff-muted); margin-top: 2px; }
.menu-choice__chevron { color: var(--ff-muted); }

.menu-visibility__options {
    display: none;
    flex-shrink: 0;
    margin-top: 6px;
    padding: 6px;
    background-color: #1C1D21;
    border-width: 1px;
    border-color: var(--ff-edge-strong);
    border-radius: 12px;
}

.menu-visibility--open .menu-visibility__options { display: flex; }

.menu-option { min-height: 46px; padding-top: 6px; padding-bottom: 6px; }
.menu-option--chosen { background-color: var(--ff-control); }
.menu-option__check { color: var(--ff-accent); display: none; }
.menu-option--chosen .menu-option__check { display: flex; }

.menu-visibility__divider { margin: 4px 6px; }
.menu-visibility__group { padding: 4px 10px 2px 10px; }

.menu-play { flex-shrink: 0; }

/* Connect to server. */
.menu-connect { width: 520px; align-self: center; margin-top: 40px; padding: 24px; }
.menu-connect__go { margin-top: 8px; }

/* Settings. */
.menu-settings__reset { margin-right: 12px; }
.menu-settings__side { width: 340px; flex-shrink: 0; margin-right: 24px; }
.menu-settings__card { padding: 22px; margin-bottom: 16px; }
.menu-settings__tip { margin-top: 10px; font-size: 13px; }

.menu-sensitivity__head { margin-top: 16px; }
.menu-sensitivity__caption { font-size: 15px; }
.menu-sensitivity__value { font-size: 16px; -unity-font-style: bold; color: var(--ff-accent); }
.menu-sensitivity__slider { margin-top: 10px; }
.menu-sensitivity__scale { margin-top: 4px; }

.menu-keys { flex-grow: 1; flex-shrink: 1; }

.menu-keys__header {
    padding: 18px 24px;
    border-bottom-width: 1px;
    border-color: var(--ff-edge);
}

.menu-keys__notice { font-size: 13px; }
.menu-keys__scroll { flex-grow: 1; }
.menu-keys__columns { align-items: flex-start; padding: 0 24px 20px 24px; }
.menu-keys__column { flex-grow: 1; flex-basis: 0; }
.menu-keys__column--second { margin-left: 32px; }

.menu-keygroup__head { padding: 16px 8px 6px 8px; }
.menu-keygroup__name { font-size: 13px; -unity-font-style: bold; }
.menu-keygroup__slot { width: 104px; margin-left: 8px; font-size: 12px; color: var(--ff-muted); -unity-text-align: middle-center; }

.menu-keyrow { padding: 3px 8px; border-radius: 8px; }
.menu-keyrow:hover { background-color: rgba(255, 255, 255, 0.03); }
.menu-keyrow__label { font-size: 14px; color: var(--ff-text-soft); }

.menu-keycap {
    width: 104px;
    height: 32px;
    margin: 0 0 0 8px;
    padding: 0 4px;
    background-color: var(--ff-control);
    border-width: 1px;
    border-color: var(--ff-control-edge);
    border-radius: 6px;
    color: var(--ff-text);
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.menu-keycap:hover { border-color: var(--ff-disabled); }
.menu-keycap--changed { color: var(--ff-accent); }
.menu-keycap--unbound { color: var(--ff-disabled); }

.menu-keycap--listening {
    background-color: var(--ff-accent-ink);
    border-color: var(--ff-accent);
    color: var(--ff-accent);
}

.menu-keycap--fixed {
    background-color: var(--ff-slot-empty);
    border-color: var(--ff-slot-empty);
    color: var(--ff-faint);
}

.menu-keycap--note {
    width: 104px;
    margin-left: 8px;
    font-size: 12px;
    color: var(--ff-disabled);
    -unity-text-align: middle-center;
}
